# Copia este archivo a .env y rellena los valores.
# .env esta en .gitignore: la clave nunca llega al repositorio.

# Clave de API de ElevenLabs (panel > Profile + API key)
ELEVENLABS_API_KEY=

# ID de la voz "El Faraon - Full, Clear, Mellow".
# Se saca del panel de ElevenLabs (Voices > la voz > icono de ID),
# o ejecutando: node cli.mjs voces
ELEVENLABS_VOICE_ID=
