      "pausa_que_lo_precede": null,
      "pausas_embebidas_dentro_del_bloque": [],
      "primeras_palabras": "El día de hoy llegó hasta aquí. Lo",
      "ultimas_palabras": "En el nombre de Jesús. Amén."
