      "shorts_incluidos": [],
      "pausa_que_lo_precede": null,
      "pausas_embebidas_dentro_del_bloque": [],
      "primeras_palabras": "Dejo que mis manos reposen donde están. Puedo",
      "ultimas_palabras": "contigo en voz baja o escuchando en silencio."
    },
    {
      "bloque": 10,
      "parrafos_indices": [
        47,
        53
      ],
      "cantidad_parrafos": 7,
      "caracteres": 1896,
      "secciones": [
