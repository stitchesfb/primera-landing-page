      ],
      "shorts_incluidos": [],
      "pausa_que_lo_precede": null,
      "pausas_embebidas_dentro_del_bloque": [],
      "primeras_palabras": "A veces el temor de mañana trae consigo",
      "ultimas_palabras": "a confiar en ti mientras llega el día."
    },
    {
      "bloque": 6,
      "parrafos_indices": [
        25,
        29
      ],
      "cantidad_parrafos": 5,
      "caracteres": 1744,
      "secciones": [
        3
      ],
      "shorts_incluidos": [
        2
      ],
      "pausa_que_lo_precede": 4,
      "pausas_embebidas_dentro_del_bloque": [
        5
      ],
      "primeras_palabras": "¿Hay alguien que te preocupa tanto que esta",
      "ultimas_palabras": "ayudar le haga sentir que su voz importa."
    },
    {
      "bloque": 7,
      "parrafos_indices": [
        30,
        35
      ],
      "cantidad_parrafos": 6,
      "caracteres": 1896,
      "secciones": [
        3
      ],
      "shorts_incluidos": [],
      "pausa_que_lo_precede": null,
      "pausas_embebidas_dentro_del_bloque": [],
      "primeras_palabras": "Cuando mi preocupación me lleve a hacer demasiadas",
      "ultimas_palabras": "hacer el bien que esté en mis manos."
    },
    {
      "bloque": 8,
      "parrafos_indices": [
        36,
        41
      ],
      "cantidad_parrafos": 6,
      "caracteres": 1824,
      "secciones": [
