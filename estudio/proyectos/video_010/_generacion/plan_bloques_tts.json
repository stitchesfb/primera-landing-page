      ],
      "shorts_incluidos": [],
      "pausa_que_lo_precede": 3,
      "pausas_embebidas_dentro_del_bloque": [],
      "primeras_palabras": "Tal vez ya sabes cuál es ese pensamiento.",
      "ultimas_palabras": "me avergüenza, dame confianza para decirlo con honestidad."
    },
    {
      "bloque": 5,
      "parrafos_indices": [
        21,
