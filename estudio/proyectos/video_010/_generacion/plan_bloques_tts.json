      "pausa_que_lo_precede": 1,
      "pausas_embebidas_dentro_del_bloque": [],
      "primeras_palabras": "Escuchemos ahora el salmo completo.",
      "ultimas_palabras": "y tu entrada, desde ahora y para siempre»."
    },
    {
      "bloque": 3,
      "parrafos_indices": [
