      ],
      "pausa_que_lo_precede": 2,
      "pausas_embebidas_dentro_del_bloque": [],
      "primeras_palabras": "Señor, aquí estoy. Tú conoces mi día, desde",
      "ultimas_palabras": "que no puedo resolver. Ayúdame a descansar. Amén."
    },
    {
      "bloque": 4,
      "parrafos_indices": [
        15,
