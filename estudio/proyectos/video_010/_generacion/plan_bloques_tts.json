      ],
      "shorts_incluidos": [],
      "pausa_que_lo_precede": 8,
      "pausas_embebidas_dentro_del_bloque": [],
      "primeras_palabras": "Volvamos un momento a esa preocupación que teníamos",
      "ultimas_palabras": "caminar por lo que todavía me cuesta entender."
    },
    {
      "bloque": 11,
      "parrafos_indices": [
