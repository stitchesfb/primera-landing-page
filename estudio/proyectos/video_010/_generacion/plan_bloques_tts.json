      ],
      "shorts_incluidos": [
        3
      ],
      "pausa_que_lo_precede": 6,
      "pausas_embebidas_dentro_del_bloque": [
        7
      ],
      "primeras_palabras": "¿Te despertaste de madrugada y tu mente ya",
      "ultimas_palabras": "quedarme un instante en silencio después de decirlas."
    },
    {
      "bloque": 9,
      "parrafos_indices": [
        42,
        46
      ],
      "cantidad_parrafos": 5,
      "caracteres": 1505,
      "secciones": [
